# ════════════════════════════════════════════════════════════
#  Intruder Detection System — Environment Configuration
#  Copy this file to .env and fill in your credentials
# ════════════════════════════════════════════════════════════

# ─── Telegram Bot Configuration ──────────────────────────────
# How to get these:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot and follow the instructions
#   3. BotFather will give you your BOT_TOKEN
#   4. Start a chat with your bot, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   5. Your CHAT_ID appears in the "chat" → "id" field

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ─── Alert Settings ──────────────────────────────────────────
# Minimum seconds between repeated alerts for the same event type
ALERT_COOLDOWN_SECONDS=30

# ─── Camera Configuration ────────────────────────────────────
# 0 = default laptop webcam
# 1, 2 = additional USB cameras
# rtsp://user:pass@192.168.1.x:554/stream = IP camera RTSP URL
CAMERA_SOURCE=0

# ─── Model Configuration ─────────────────────────────────────
# Options: yolov8n.pt (fastest), yolov8s.pt, yolov8m.pt, yolov8l.pt
YOLO_MODEL=yolov8n.pt

# Minimum confidence threshold for detections (0.0 - 1.0)
DETECTION_CONFIDENCE=0.5

# ─── Night Vision ────────────────────────────────────────────
# Mean brightness below this value triggers night vision mode
NIGHT_VISION_THRESHOLD=80

# ─── Loitering Detection ─────────────────────────────────────
# Seconds an unknown person must be present before loitering alert
LOITERING_THRESHOLD_SECONDS=30

# ─── Face Recognition ────────────────────────────────────────
# Number of frames to accumulate for Grassmann subspace matching
GRASSMANN_FRAME_COUNT=10

# Cosine distance threshold for face matching (lower = stricter)
FACE_MATCH_THRESHOLD=0.4
